{
  "name": "quilllens",
  "version": "0.2.0",
  "private": true,
  "description": "Anne's Lens: an original open-source picture viewer, organizer and converter in the tradition of IrfanView, with a complete, customizable command library.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/gen-plan-ts.mjs",
    "prebuild": "node scripts/gen-plan-ts.mjs && node scripts/gen-notices.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/gen-plan-ts.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "pretest": "node scripts/gen-plan-ts.mjs",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:desktop": "node scripts/prepare-desktop.mjs && node tests/e2e/desktop.mjs",
    "plan": "python3 scripts/gen-plan.py && node scripts/gen-plan-ts.mjs",
    "catalog": "vite-node scripts/gen-catalog.ts",
    "notices": "node scripts/gen-notices.mjs",
    "cap:sync": "npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "ios:sync": "npm run build && npx cap sync ios",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:test": "node scripts/build-desktop.mjs --test",
    "desktop": "npm run build:desktop && node scripts/prepare-desktop.mjs && electron build/desktop-app",
    "desktop:dist": "npm run build:desktop && node scripts/prepare-desktop.mjs && electron-builder --config electron-builder.config.cjs",
    "icons": "node resources/gen-icon.mjs && node scripts/gen-android-icons.mjs && node scripts/gen-platform-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "djvu-rs": "^0.43.0",
    "fzstd": "^0.1.1",
    "material-symbols": "^0.48.0",
    "world-atlas": "^2.0.2",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cornerstonejs/codec-openjph": "^2.4.11",
    "@huggingface/transformers": "^4.3.2",
    "@jsquash/avif": "^2.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^43.7.7",
    "electron-builder": "^26.17.0",
    "jsdom": "^29.1.1",
    "jxl-oxide-wasm": "^0.12.6",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
